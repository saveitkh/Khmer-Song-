# ─────────────────────────────────────────────────────────────────────────────
# Khmer Sonic AI — server configuration.  Copy to .env and fill in.
# NEVER commit real secrets. The frontend is served by this same service and
# receives NONE of these values — every provider key stays server-side.
# ─────────────────────────────────────────────────────────────────────────────

# Port the Node service listens on (Docker/Caddy proxy to this; leave 3000).
PORT=3000

# Public https origin this Mini App is served at, e.g.
# https://song.184-174-38-113.sslip.io  — used for CORS and absolute links.
PUBLIC_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Telegram Mini Apps authenticate with signed initData. Set this to the SAME
# bot token the Telegram bot uses (TELEGRAM_LOGIN_BOT_TOKEN in the bot repo) so
# the server can verify the HMAC and trust the user id. Unset = DEV MODE: a
# fake user is injected and auth is skipped (never deploy with it unset).
TELEGRAM_BOT_TOKEN=
# Reject initData older than this many seconds (replay protection).
TELEGRAM_INITDATA_MAX_AGE_S=86400

# Browser-preview mode: when "on", requests without valid Telegram initData are
# served as a shared demo user (mock data), so you can open the URL in a normal
# browser and explore the whole app without Telegram. Keep "off" for real
# production — on means anyone with the link can browse.
ALLOW_BROWSER_DEMO=off

# ── Engine selection ─────────────────────────────────────────────────────────
# Which adapter answers each kind of job. Everything ships working on "mock"
# so the whole app runs and deploys with no keys. Swap to a real adapter once
# its key/worker below is set and evaluated.
#   VOICE_PROVIDER : mock | voxcpm2 | gemini-tts     (speaking clone / preview)
#   LYRICS_PROVIDER: mock | claude                   (Khmer lyric generation)
#   MUSIC_PROVIDER : mock | gemini-lyria             (song generation)
VOICE_PROVIDER=mock
LYRICS_PROVIDER=mock
MUSIC_PROVIDER=mock

# ── Lyrics: Claude (Anthropic) ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ── Song + TTS: Google Gemini (AI Studio key, not Cloud Console) ─────────────
GEMINI_API_KEY=
GEMINI_LYRIA_MODEL=lyria-3.5
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ── Voice clone: self-hosted VoxCPM2 GPU worker (never exposed publicly) ─────
# The worker is a FastAPI service on Modal/RunPod/Replicate or your GPU box.
# This API calls it over https with a shared secret.
VOXCPM_WORKER_URL=
VOXCPM_WORKER_SECRET=

# ── Supabase (auth-adjacent data, DB). Optional for mock mode. ───────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare R2 (private buckets; presigned URLs only). Optional for mock. ─
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_VOICE_REFS=ks-voice-refs
R2_BUCKET_OUTPUTS=ks-outputs
R2_PUBLIC_BASE=

# ── Safety / limits ──────────────────────────────────────────────────────────
# Per-user daily job cap and a global daily spend cap (USD) as a kill-switch.
RATE_LIMIT_PER_USER_PER_DAY=50
DAILY_SPEND_CAP_USD=25
# Flip any provider off instantly without a redeploy.
KILLSWITCH_VOICE=off
KILLSWITCH_LYRICS=off
KILLSWITCH_MUSIC=off
# Watermark generated audio + tag it "AI-generated" (default on).
AUDIO_WATERMARK=on
