{
  "name": "khmer-sonic-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Khmer Sonic AI — a Telegram Mini App (installable PWA) for Khmer voice cloning, Khmer lyric writing and AI song creation. One Node service serves the built React PWA and the API.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace server run dev",
    "build": "npm --workspace web run build",
    "start": "npm --workspace server run start",
    "test": "npm --workspace server run test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
